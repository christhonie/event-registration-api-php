<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<groupId>za.co.idealogic</groupId>
	<artifactId>event-service-php-client</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<name>Event Membership Registration PHP Client</name>
	<description>PHP client for the Event Admin Service API for event registration.</description>

	<parent>
		<groupId>za.co.idealogic</groupId>
		<artifactId>event</artifactId>
		<version>1.0.13</version>
	</parent>

	<properties>
		<revision>2.2.2</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>1.8</java.version>
		<openapi-generator.version>7.10.0</openapi-generator.version>
		<swagger.file>openapi.json</swagger.file>
	</properties>

	<build>
		<defaultGoal>generate-sources</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version> <!-- Use the latest version -->
				<executions>
					<execution>
						<id>clean-generated-sources</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<filesets>
								<fileset>
									<directory>${project.basedir}/docs</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</fileset>
								<fileset>
									<directory>${project.basedir}/lib</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.2.0</version>
				<configuration>
					<generatorName>php</generatorName>
					<inputSpec>${swagger.file}</inputSpec>
					<!-- The client generates an explicit allow-list (apisToGenerate/modelsToGenerate),
					     so whole-spec validation is overly strict here. Skipping it unblocks
					     regeneration despite unrelated spec defects (e.g. path-param declarations on
					     endpoints not in the generate list). Revisit once the admin-service spec is clean. -->
					<skipValidateSpec>true</skipValidateSpec>
					<output>.</output>
					<generateApiTests>false</generateApiTests>
					<generateModelTests>false</generateModelTests>
					<generateSupportingFiles>true</generateSupportingFiles>
					<configOptions>
						<artifactVersion>${project.version}</artifactVersion>
						<appDescription>API Client for the Event Admin Service</appDescription>
						<packageName>EventRegistrationClient</packageName>
						<composerPackageName>idealogic/event-registration-api</composerPackageName>
						<artifactUrl>http://www.idealogic.co.za</artifactUrl>
						<developerOrganization>Idealogic</developerOrganization>
						<developerOrganizationUrl>https://www.idealogic.co.za</developerOrganizationUrl>
						<licenseName>proprietary</licenseName>
						<invokerPackage>Idealogic\RegistrationAPI</invokerPackage>
					</configOptions>
					<apisToGenerate>
						OrganisationResource,PersonResource,ResultSet,RaceResult,CustomList,CustomListValue,OrderResourceEx,MembershipResourceEx
					</apisToGenerate>
					<!-- No <modelsToGenerate>: every schema in the spec is generated, deliberately.

					     The allowlist had to be closed under $ref by hand — every model reachable
					     from a listed one had to be listed too — and it silently was not. The
					     generator emits a reference to an unlisted model without emitting the class,
					     and PHP has no compile step, so the omission only surfaces at runtime, the
					     first time a payload carries that field, as
					     `Class "...\Model\XxxDTO" not found`. That is ADO Bug #919: ParticipantOrderDTO.buyer
					     referenced PersonNameDTO, which was never generated, so deserialising a
					     perfectly good 200 threw and every order sync was reported to the operator as
					     failed. It went unnoticed in production for months.

					     #919 was fixed by closing the list by hand. It came straight back: by
					     2026-08-26 the list was missing 19 models, 9 of them referenced by generated
					     Api classes with no file on disk. Hand-maintaining a transitive closure
					     against a spec that changes weekly is not a thing that stays correct.

					     Dropping the list removes the failure mode rather than re-policing it. It
					     costs repo size and nothing else: PHP autoloads lazily, so a class no caller
					     touches is never read. <apisToGenerate> is kept and still governs the surface
					     that matters — this client speaks to a small subset of admin-service, the two
					     filters are independent, and removing this one left the generated API set at
					     exactly the same 4 classes. -->
					<!-- <modelsToGenerate> intentionally omitted; see above. -->
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>github-christhonie</id>
			<url>https://maven.pkg.github.com/christhonie/event</url>
			<releases>
				<enabled>true</enabled>
				<checksumPolicy>fail</checksumPolicy>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

</project>